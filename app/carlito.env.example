# Copy to carlito.env on your tablet, or enter these in AppLoad Settings.
CARLITO_MODE=auto
CARLITO_GEMINI_KEY=your-gemini-key-here
CARLITO_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash
# Live Google Search: Gemini decides when fresh facts need checking.
CARLITO_WEB_SEARCH=1
CARLITO_MAX_TOKENS=1400
# Optional local vision server for offline mode / automatic fallback.
# CARLITO_OFFLINE_BASE=http://192.168.1.10:11434/v1
# CARLITO_OFFLINE_MODEL=qwen2.5vl:3b
# CARLITO_OFFLINE_KEY=local
